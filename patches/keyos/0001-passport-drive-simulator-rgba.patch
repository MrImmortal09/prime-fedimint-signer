+#[cfg(test)]
+mod tests {
+    use std::io::Cursor;
+
+    use super::*;
+
+    fn first_pixel(payload: &[u8], simulator: bool) -> [u8; 3] {
+        let bytes = screenshot_to_png(payload, simulator).unwrap();
+        let mut decoder = png::Decoder::new(Cursor::new(bytes)).read_info().unwrap();
+        let mut output = vec![0; decoder.output_buffer_size()];
+        decoder.next_frame(&mut output).unwrap();
+        output[..3].try_into().unwrap()
+    }
+
+    #[test]
+    fn simulator_preserves_rgba_channel_order() {
+        let mut payload = vec![0; FB_SIZE];
+        payload[..4].copy_from_slice(&[214, 154, 120, 255]);
+        assert_eq!(first_pixel(&payload, true), [214, 154, 120]);
+    }
+
+    #[test]
+    fn hardware_decodes_bgra_channel_order() {
+        let mut payload = vec![0; FB_SIZE];
+        payload[..4].copy_from_slice(&[120, 154, 214, 255]);
+        assert_eq!(first_pixel(&payload, false), [214, 154, 120]);
+    }
+
+    #[test]
+    fn truncated_capture_is_rejected() {
+        assert!(screenshot_to_png(&[], true).is_err());
+        assert!(screenshot_to_png(&[], false).is_err());
+    }
+}
