+/// The capture API returns RGBA8888 on the simulator and BGRA8888 on hardware.
+pub fn screenshot_to_png(pixels: &[u8], simulator: bool) -> Result<Vec<u8>, String> {
+    if pixels.len() < FB_SIZE {
+        return Err(format!("Screenshot payload too small: {} bytes, expected {}", pixels.len(), FB_SIZE));
     }

+    let red = if simulator { 0 } else { 2 };
+    let blue = if simulator { 2 } else { 0 };
     let pixel_count = FB_SIZE / 4;
     let mut rgb = vec![0u8; pixel_count * 3];
     for i in (0..FB_SIZE).step_by(4) {
         let j = (i / 4) * 3;
-        rgb[j] = bgra[i + 2]; // R
-        rgb[j + 1] = bgra[i + 1]; // G
-        rgb[j + 2] = bgra[i]; // B
+        rgb[j] = pixels[i + red]; // R
+        rgb[j + 1] = pixels[i + 1]; // G
+        rgb[j + 2] = pixels[i + blue]; // B
     }

     let mut png_buf = Vec::new();
@@ -30,3 +32,38 @@ pub fn bgra_to_png(bgra: &[u8]) -> Result<Vec<u8>, String> {
     }
