+/// How long to wait before claiming a refund again after attempt `attempt`
+/// failed: ten seconds, doubling to at most an hour.
+fn refund_retry_delay(attempt: u32) -> Duration {
+    Duration::from_secs(10)
+        .saturating_mul(2u32.saturating_pow(attempt))
+        .min(Duration::from_secs(60 * 60))
+}
