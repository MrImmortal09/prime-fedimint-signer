+//! Where the refund keys of outgoing contracts come from.
+//!
+//! By default the client derives each contract's refund key from an ephemeral
+//! key and the module's static key. A client whose keys live on an external
+//! signer sets [`RefundKeys`] in
+//! [`LightningClientInit::refund_keys`](crate::LightningClientInit::refund_keys):
+//! the signer then signs refunds through the client's
+//! [`TransactionSigner`](fedimint_client_module::transaction::TransactionSigner),
+//! and authorises gateways to pay.
+
+use std::fmt::Debug;
+use std::sync::Arc;
+
+use fedimint_client_module::transaction::RemoteKey;
+use fedimint_core::encoding::{Decodable, Encodable};
+use fedimint_core::secp256k1::schnorr::Signature;
+use fedimint_core::secp256k1::{Keypair, PublicKey};
+use fedimint_core::task::{MaybeSend, MaybeSync};
+use fedimint_core::{apply, async_trait_maybe_send};
+use fedimint_lnv2_common::LightningInvoice;
+use fedimint_lnv2_common::contracts::OutgoingContract;
+
+/// The key that refunds an outgoing contract.
+#[derive(Debug, Clone, Eq, PartialEq, Hash, Decodable, Encodable)]
+pub enum RefundKey {
+    /// This client holds the key.
+    Local(Keypair),
+    /// An external signer holds the key, reached through [`RefundKeys`].
+    Remote,
+}
+
+/// Refund keys held by an external signer.
+#[apply(async_trait_maybe_send!)]
+pub trait RefundKeys: Debug + MaybeSend + MaybeSync + 'static {
+    /// The ephemeral point and the refund key of a new outgoing contract.
+    fn new_refund_key(&self) -> (PublicKey, PublicKey);
+
+    /// The key that signs a refund of `contract`, for the client's
+    /// transaction signer.
+    fn remote_key(&self, contract: &OutgoingContract) -> RemoteKey;
+
+    /// The refund key's signature over the hash of `invoice`, with which the
+    /// gateway checks that whoever funded `contract` asked for this payment.
+    async fn gateway_auth(
+        &self,
+        contract: &OutgoingContract,
+        invoice: &LightningInvoice,
+    ) -> Result<Signature, String>;
+}
+
+pub type DynRefundKeys = Arc<dyn RefundKeys>;
