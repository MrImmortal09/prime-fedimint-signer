@@ -0,0 +1,89 @@
+//! Where the module's note keys come from.
+//!
+//! [`MintClientInit`](crate::MintClientInit) derives every note key from the
+//! module's root secret. A client whose spend keys live on an external signer,
+//! such as a hardware device, uses
+//! [`MintClientInitWithKeys`](crate::MintClientInitWithKeys) with a
+//! [`NoteKeyProvider`] that knows each note's nonce and blinding key but not
+//! its spend key. Such notes are spent through the client's
+//! [`TransactionSigner`](fedimint_client_module::transaction::TransactionSigner).
+
+use std::fmt::Debug;
+use std::sync::Arc;
+
+use fedimint_client_module::transaction::RemoteKey;
+use fedimint_core::encoding::{Decodable, Encodable};
+use fedimint_core::secp256k1::{Keypair, PublicKey};
+use fedimint_core::task::{MaybeSend, MaybeSync};
+use fedimint_derive_secret::DerivableSecret;
+use fedimint_mintv2_common::Denomination;
+use tbs::BlindingKey;
+
+use crate::issuance;
+
+/// The key that spends a note.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Encodable, Decodable)]
+pub enum NoteSpendKey {
+    /// This client holds the key.
+    Local(Keypair),
+    /// An external signer holds the key.
+    Remote(RemoteKey),
+}
+
+impl NoteSpendKey {
+    /// The note's nonce: the key's public key.
+    pub fn public_key(&self) -> PublicKey {
+        match self {
+            Self::Local(keypair) => keypair.public_key(),
+            Self::Remote(remote) => remote.public_key,
+        }
+    }
+}
+
+/// The keys of the note at one denomination and tweak.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct NoteKeys {
+    pub spend_key: NoteSpendKey,
+    pub blinding_key: BlindingKey,
+}
+
+/// Derives the keys of the notes this client issues to itself.
+pub trait NoteKeyProvider: Debug + MaybeSend + MaybeSync + 'static {
+    /// The seed of the recovery filter. Every tweak the client issues passes
+    /// [`issuance::check_tweak`] against it, which is how a recovery recognises
+    /// the client's notes among everyone's.
+    fn tweak_filter(&self) -> [u8; 32];
+
+    /// The keys of the note at `(denomination, tweak)`.
+    fn note_keys(&self, denomination: Denomination, tweak: [u8; 16]) -> NoteKeys;
+
+    /// Whether the client holds the spend keys. A client that does not cannot
+    /// hand out notes as e-cash itself.
+    fn holds_spend_keys(&self) -> bool;
+}
+
+pub type DynNoteKeyProvider = Arc<dyn NoteKeyProvider>;
+
+/// Every key from the module's root secret, as fedimint has always derived
+/// them.
+#[derive(Debug, Clone)]
+pub struct RootSecretKeys(pub DerivableSecret);
+
+impl NoteKeyProvider for RootSecretKeys {
+    fn tweak_filter(&self) -> [u8; 32] {
+        issuance::tweak_filter(&self.0)
+    }
+
+    fn note_keys(&self, denomination: Denomination, tweak: [u8; 16]) -> NoteKeys {
+        let secret = issuance::output_secret(denomination, tweak, &self.0);
+
+        NoteKeys {
+            spend_key: NoteSpendKey::Local(issuance::keypair(&secret)),
+            blinding_key: issuance::blinding_key(&secret),
+        }
+    }
+
+    fn holds_spend_keys(&self) -> bool {
+        true
+    }
+}
