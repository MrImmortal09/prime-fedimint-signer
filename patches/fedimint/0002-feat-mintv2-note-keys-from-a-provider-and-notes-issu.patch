+/// A note the wallet holds, spendable with a key held here or by an external
+/// signer.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Encodable, Decodable)]
+pub struct WalletNote {
+    pub denomination: Denomination,
+    pub spend_key: NoteSpendKey,
+    pub signature: tbs::Signature,
+}
+
+impl WalletNote {
+    pub fn amount(&self) -> Amount {
+        self.denomination.amount()
+    }
+
+    pub fn nonce(&self) -> PublicKey {
+        self.spend_key.public_key()
+    }
+
+    pub fn note(&self) -> Note {
+        Note {
+            denomination: self.denomination,
+            nonce: self.nonce(),
+            signature: self.signature,
+        }
+    }
+
+    /// The note as bearer e-cash, if this client holds its key.
+    pub fn spendable(&self) -> Option<SpendableNote> {
+        match &self.spend_key {
+            NoteSpendKey::Local(keypair) => Some(SpendableNote {
+                denomination: self.denomination,
+                keypair: *keypair,
+                signature: self.signature,
+            }),
+            NoteSpendKey::Remote(_) => None,
+        }
+    }
+}
+
+impl From<SpendableNote> for WalletNote {
+    fn from(note: SpendableNote) -> Self {
+        Self {
+            denomination: note.denomination,
+            spend_key: NoteSpendKey::Local(note.keypair),
+            signature: note.signature,
+        }
+    }
+}
+
+/// A note to issue to keys this client does not derive, such as an external
+/// signer's.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ExternalNoteRequest {
+    pub denomination: Denomination,
+    /// Must pass the recovery filter of whoever derives the keys.
+    pub tweak: [u8; 16],
+    pub nonce: PublicKey,
+    pub blinding_key: tbs::BlindingKey,
+}
+
+/// A note issued to keys outside the wallet, with its unblinded signature.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Encodable, Decodable)]
+pub struct IssuedExternalNote {
+    pub denomination: Denomination,
+    pub tweak: [u8; 16],
+    pub nonce: PublicKey,
+    pub signature: tbs::Signature,
+}
+
+impl IssuedExternalNote {
+    pub fn note(&self) -> Note {
+        Note {
+            denomination: self.denomination,
+            nonce: self.nonce,
+            signature: self.signature,
+        }
+    }
+}
