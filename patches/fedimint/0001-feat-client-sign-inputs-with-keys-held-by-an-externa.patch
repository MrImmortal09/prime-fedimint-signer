+/// A transaction with all its inputs and outputs, before signing.
+#[derive(Debug)]
+pub struct UnsignedTransaction {
+    /// The transaction, without signatures.
+    transaction: Transaction,
+    local_keys: Vec<Vec<Keypair>>,
+    remote_keys: Vec<Vec<RemoteKey>>,
+    states: Vec<DynState>,
+}
+
+impl UnsignedTransaction {
+    /// The id every signature commits to.
+    pub fn txid(&self) -> TransactionId {
+        self.transaction.tx_hash()
+    }
+
+    /// The transaction, without signatures.
+    pub fn transaction(&self) -> &Transaction {
+        &self.transaction
+    }
+
+    /// For every input, the keys an external signer must sign with.
+    pub fn remote_keys(&self) -> &[Vec<RemoteKey>] {
+        &self.remote_keys
+    }
+
+    /// Whether any input needs an external signer.
+    pub fn needs_remote_signatures(&self) -> bool {
+        self.remote_keys.iter().any(|keys| !keys.is_empty())
+    }
+
+    /// Signs with the local keys and inserts `remote_signatures`, one per
+    /// remote key in input order, after checking each against its key. Each
+    /// input carries the signatures of its local keys, then of its remote
+    /// keys.
+    pub fn sign<C>(
+        self,
+        secp_ctx: &Secp256k1<C>,
+        remote_signatures: Vec<schnorr::Signature>,
+    ) -> Result<(Transaction, Vec<DynState>), RemoteSignatureError>
+    where
+        C: secp256k1::Signing + secp256k1::Verification,
+    {
+        let expected = self.remote_keys.iter().map(Vec::len).sum::<usize>();
+        if remote_signatures.len() != expected {
+            return Err(RemoteSignatureError::Count {
+                expected,
+                got: remote_signatures.len(),
+            });
+        }
+
+        let txid = self.txid();
+        let msg = secp256k1::Message::from_digest_slice(&txid[..]).expect("txid has right length");
+        let mut remote_signatures = remote_signatures.into_iter().enumerate();
+        let mut signatures = Vec::new();
+
+        for (local_keys, remote_keys) in self.local_keys.iter().zip(&self.remote_keys) {
+            for keypair in local_keys {
+                signatures.push(secp_ctx.sign_schnorr(&msg, keypair));
+            }
+
+            for remote_key in remote_keys {
+                let (index, signature) = remote_signatures
+                    .next()
+                    .expect("The count was checked above");
+                secp_ctx
+                    .verify_schnorr(
+                        &signature,
+                        &msg,
+                        &remote_key.public_key.x_only_public_key().0,
+                    )
+                    .map_err(|_| RemoteSignatureError::Invalid { index })?;
+                signatures.push(signature);
+            }
+        }
+
+        let transaction = Transaction {
+            signatures: TransactionSignature::NaiveMultisig(signatures),
+            ..self.transaction
+        };
+
+        Ok((transaction, self.states))
+    }
+}
+
+/// Why an external signer's signatures cannot complete a transaction.
+#[derive(Debug, Clone, Error)]
+pub enum RemoteSignatureError {
+    /// The signer returned the wrong number of signatures.
+    #[error("Expected {expected} remote signatures, got {got}")]
+    Count { expected: usize, got: usize },
+    /// A signature does not verify against its key and the transaction id.
+    #[error("Remote signature {index} does not verify")]
+    Invalid { index: usize },
+}
