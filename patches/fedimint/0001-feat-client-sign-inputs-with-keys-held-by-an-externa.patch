+//! Signing transaction inputs with keys the client does not hold.
+//!
+//! A module whose spend keys live elsewhere, for example on a hardware signer
+//! with a trusted display, attaches [`RemoteKey`]s to its inputs with
+//! [`ClientInputBundle::with_remote_keys`](super::ClientInputBundle::with_remote_keys).
+//! When a transaction has remote keys, the client builds it without
+//! signatures, passes it to the [`TransactionSigner`] set on the client, and
+//! checks every signature it returns before submitting.
+
+use std::fmt::Debug;
+use std::sync::Arc;
+
+use bitcoin::secp256k1::{PublicKey, schnorr};
+use fedimint_core::core::{ModuleKind, OperationId};
+use fedimint_core::encoding::{Decodable, Encodable};
+use fedimint_core::task::{MaybeSend, MaybeSync};
+use fedimint_core::transaction::Transaction;
+use fedimint_core::{TransactionId, apply, async_trait_maybe_send};
+use serde::{Deserialize, Serialize};
+use thiserror::Error;
+
+/// A key held by an external signer.
+#[derive(Debug, Clone, PartialEq, Eq, Hash, Encodable, Decodable, Serialize, Deserialize)]
+pub struct RemoteKey {
+    /// The key the federation checks the input's signature against.
+    pub public_key: PublicKey,
+    /// What the signer needs to find or derive the secret key, in a format
+    /// defined by the module that creates the input.
+    pub key_ref: Vec<u8>,
+}
+
+/// The remote keys of one transaction input.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct RemoteSigningInput {
+    /// The kind of the module the input belongs to, which defines the format
+    /// of its keys' [`RemoteKey::key_ref`].
+    pub module_kind: ModuleKind,
+    /// The keys to sign with, after the input's local keys.
+    pub keys: Vec<RemoteKey>,
+}
+
+/// The operation a transaction belongs to, as the operation log records it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SigningOperation {
+    pub operation_type: String,
+    pub meta: serde_json::Value,
+}
+
+/// A transaction waiting for an external signer.
+#[derive(Debug, Clone)]
+pub struct SigningRequest {
+    pub operation_id: OperationId,
+    /// `None` for a transaction a state machine submits on its own, such as a
+    /// refund, which has no operation log entry of its own.
+    pub operation: Option<SigningOperation>,
+    /// The transaction, without signatures.
+    pub transaction: Transaction,
+    /// One entry per transaction input, in input order.
+    pub inputs: Vec<RemoteSigningInput>,
+}
+
+impl SigningRequest {
+    /// The transaction id every signature commits to.
+    pub fn txid(&self) -> TransactionId {
+        self.transaction.tx_hash()
+    }
+
+    /// How many signatures the signer must return.
+    pub fn signature_count(&self) -> usize {
+        self.inputs.iter().map(|input| input.keys.len()).sum()
+    }
+}
+
+/// Why an external signer did not sign.
+#[derive(Debug, Clone, Error)]
+pub enum TransactionSignerError {
+    /// The signer, or the person using it, declined.
+    #[error("The signer declined: {0}")]
+    Declined(String),
+    /// The signer could not be reached, or failed.
+    #[error("The signer is unavailable: {0}")]
+    Unavailable(String),
+}
+
+/// Signs transactions with keys the client does not hold.
+#[apply(async_trait_maybe_send!)]
+pub trait TransactionSigner: Debug + MaybeSend + MaybeSync + 'static {
+    /// Signs [`SigningRequest::txid`] with every remote key of
+    /// `request.inputs` and returns the BIP-340 signatures in that order.
+    ///
+    /// The client verifies each signature before it submits the transaction.
+    async fn sign(
+        &self,
+        request: &SigningRequest,
+    ) -> Result<Vec<schnorr::Signature>, TransactionSignerError>;
+}
+
+pub type DynTransactionSigner = Arc<dyn TransactionSigner>;
