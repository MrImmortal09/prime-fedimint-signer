import { Theme, UISize, ControlSize, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Switch } from "@ui/switch.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Callbacks } from "../../callbacks.slint";
import { Heading, Muted } from "../../widgets.slint";
export component SettingsPagePage inherits Rectangle {
    background: Theme.palette-background;
    VerticalLayout {
        padding: 24px; padding-top: 24px + UISize.control-center-status-bar-height; spacing: 16px;
        Heading { text: "Your signer"; horizontal-alignment: left; }
        Muted { text: "Prime Ecash · Fedimint · QR transport"; font-size: 14px; horizontal-alignment: left; }
        Flickable {
            vertical-stretch: 1;
            VerticalLayout {
                width: parent.width; spacing: 12px; alignment: start;
                Rectangle {
                    background: Theme.palette-card; border-radius: 16px;
                    HorizontalLayout {
                        padding: 16px; spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 8px;
                            Text { text: "PIN for large spends"; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                            Muted { text: "Require your PIN above 100,000 sats."; font-size: 14px; horizontal-alignment: left; }
                        }
                        Switch {
                            width: 64px; height: 64px;
                            accessible-role: checkbox; accessible-label: "PIN for large spends"; accessible-checked: Callbacks.setting-pin;
                            checked: Callbacks.setting-pin;
                            changed(value) => { Callbacks.setting-pin = value; Callbacks.settings-changed(); }
                        }
                    }
                }
                Rectangle {
                    background: Theme.palette-card; border-radius: 16px;
                    HorizontalLayout {
                        padding: 16px; spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 8px;
                            Text { text: "Check mint signatures"; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                            Muted { text: "Verify notes before signing. This takes longer."; font-size: 14px; horizontal-alignment: left; }
                        }
                        Switch {
                            width: 64px; height: 64px;
                            accessible-role: checkbox; accessible-label: "Check mint signatures"; accessible-checked: Callbacks.setting-verify-notes;
                            checked: Callbacks.setting-verify-notes;
                            changed(value) => { Callbacks.setting-verify-notes = value; Callbacks.settings-changed(); }
                        }
                    }
                }
                Rectangle {
                    background: Theme.palette-card; border-radius: 16px;
                    HorizontalLayout {
                        padding: 16px; spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 8px;
                            Text { text: "Release prepared ecash"; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                            Muted { text: "Allow release without a second review after approving preparation."; font-size: 14px; horizontal-alignment: left; }
                        }
                        Switch {
                            width: 64px; height: 64px;
                            accessible-role: checkbox; accessible-label: "Release prepared ecash"; accessible-checked: Callbacks.setting-auto-release;
                            checked: Callbacks.setting-auto-release;
                            changed(value) => { Callbacks.setting-auto-release = value; Callbacks.settings-changed(); }
                        }
                    }
                }
                Muted { text: Callbacks.setting-summary; font-size: 14px; horizontal-alignment: left; }
                if Callbacks.federations.length > 0: Muted {
                    text: "Forget a federation to stop signing for it. Tap twice. Released-note records stay.";
                    font-size: 14px; horizontal-alignment: left;
                }
                for federation[index] in Callbacks.federations: Rectangle {
                    background: Theme.palette-card; border-radius: 16px;
                    HorizontalLayout {
                        padding: 16px; spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1; spacing: 8px;
                            Text { text: federation.name; color: Theme.palette-foreground; font-family: Theme.font-primary; font-size: 18px; font-weight: 600; wrap: word-wrap; }
                            Muted { text: federation.detail; font-size: 14px; horizontal-alignment: left; }
                        }
                        Button {
                            text: Callbacks.forget-armed == index ? "Confirm" : "Forget";
                            variant: ButtonVariant.secondary; size: ControlSize.sm;
                            clicked => { Callbacks.forget-federation(index); }
                        }
                    }
                }
                if Callbacks.status != "": Muted { text: Callbacks.status; color: Theme.palette-danger; }
            }
        }
        Button { text: "Back"; full-width: true; clicked => { Callbacks.forget-armed = -1; Navigate.backward(); } }
    }
}
