import { Theme, UISize, ControlSize, ButtonVariant } from "@ui/theme.slint";
import { Button } from "@ui/button.slint";
import { Switch } from "@ui/switch.slint";
import { Navigate } from "../../gen/navigate.slint";
import { Callbacks } from "../../callbacks.slint";
import { Heading, Muted } from "../../widgets.slint";

export component SettingsPagePage inherits Rectangle {
    background: Theme.palette-background;

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Theme.spacing-xl;
        padding-right: Theme.spacing-xl;
        padding-top: Theme.spacing-xl + UISize.control-center-status-bar-height;
        padding-bottom: Theme.spacing-xl;
        spacing: Theme.spacing-lg;

        Heading { text: "Settings"; }

        Switch {
            label: "PIN above 100,000 sats";
            description: "Ask for the PIN before approving anything larger.";
            checked: Callbacks.setting-pin;
            changed(value) => {
                Callbacks.setting-pin = value;
                Callbacks.settings-changed();
            }
        }

        Switch {
            label: "Check mint signatures";
            description: "Verify every note before signing. Slower, catches forged notes early.";
            checked: Callbacks.setting-verify-notes;
            changed(value) => {
                Callbacks.setting-verify-notes = value;
                Callbacks.settings-changed();
            }
        }

        Switch {
            label: "Send prepared ecash without asking again";
            description: "After you approve preparing a send, release it when the phone asks.";
            checked: Callbacks.setting-auto-release;
            changed(value) => {
                Callbacks.setting-auto-release = value;
                Callbacks.settings-changed();
            }
        }

        Muted {
            text: Callbacks.setting-summary;
            font-size: Theme.font-size-label;
        }

        if Callbacks.federations.length > 0: Muted {
            text: "Forget a federation to stop signing for it. Tap twice. The record of notes released for it stays.";
            font-size: Theme.font-size-label;
        }

        for federation[index] in Callbacks.federations: HorizontalLayout {
            spacing: Theme.spacing-md;
            Text {
                text: federation.name;
                color: Theme.palette-foreground;
                font-family: Theme.font-primary;
                font-size: Theme.font-size-subtitle;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Button {
                text: Callbacks.forget-armed == index ? "Confirm" : "Forget";
                variant: ButtonVariant.secondary;
                size: ControlSize.md;
                clicked => {
                    Callbacks.forget-federation(index);
                }
            }
        }

        Rectangle { vertical-stretch: 1; }

        Button {
            width: 100%;
            text: "Back";
            size: ControlSize.md;
            full-width: true;
            clicked => {
                Callbacks.forget-armed = -1;
                Navigate.backward();
            }
        }
    }
}
